# ── Optional integrations ────────────────────────────────────────────────
# Without these, the app runs fully on free RSS feeds with local data.
# Every feature below degrades honestly (it is disabled + explained in the UI,
# never faked) when its key is missing.

# AI (OpenAI-compatible endpoint). Enables: grounded summaries with a
# "Why it matters" line, Urdu translation, custom-topic parsing.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Extra news source (newsapi.org). Free tier gives 100 req/day.
NEWSAPI_KEY=

# Secret protecting GET /api/cron/refresh (used by scheduler). Any random string.
CRON_SECRET=

# Web Push (VAPID) for notifications while the browser/tab is closed.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Future migration to Supabase (see docs/schema.sql and README §Deployment).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
